# OpenGraph.io API key (either one of these is required)
OPENGRAPH_APP_ID=your_app_id_here
# Alternative name (use one or the other)
# APP_ID=your_app_id_here

# Server port for SSE transport (default: 3010)
PORT=3010 

# Proxies in front of the HTTP server, for per client rate limiting (default: 1).
# Use false when clients connect directly.
# MCP_TRUST_PROXY=1

# HTTP server only. Accept the legacy x-app-id header (default: off).
# MCP_ALLOW_LEGACY_APP_ID=true

# Interface to listen on (default: 127.0.0.1; the Docker image sets 0.0.0.0).
# MCP_HOST=127.0.0.1
